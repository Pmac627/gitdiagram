<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production web.config for the IIS host (httpPlatformHandler runs the
  standalone server.js). Based on the host's NodeJS Manager file, plus what
  this app needs. Probe results (2026-09-29):
  - The manager's defaults buffered SSE and cut it at ~125 s (httpPlatform
    requestTimeout defaults to 2 minutes, responseBufferLimit to 4 MB). The
    host's ARR front end still buffers below ~8 KB, so the app pads its SSE
    flushes (SSE_FLUSH_PAD_BYTES).
  - Adding the compression and request-filtering sections gave HTTP 500
    (sections locked by the host). Leave them out. <rewrite> is allowed.
  - The httpTohttps rule comes from the panel's "force HTTPS" toggle. Keep it:
    uploading a web.config without it silently turns the redirect off.
  Changing settings in the NodeJS Manager may regenerate this file; re-apply.

  Only non-secret values belong here. Secrets are set as application pool
  environment variables, never in this file.
  If the host refuses the log folder, use stdoutLogFile=".\log.txt".
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" responseBufferLimit="0" />
    </handlers>
    <httpPlatform processPath="node" arguments="server.js" startupTimeLimit="20" startupRetryCount="1" requestTimeout="00:10:00" stdoutLogEnabled="true" stdoutLogFile=".\App_Data\logs\node.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="DATA_DIR" value="App_Data" />
        <environmentVariable name="SSE_FLUSH_PAD_BYTES" value="9216" />
      </environmentVariables>
    </httpPlatform>
    <rewrite>
      <rules>
        <rule name="httpTohttps" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
