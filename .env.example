CACHE_KEY_SECRET=
# Folder for the SQLite database (gitdiagram.db) and stored diagrams and videos. Required.
# Local: any folder outside the repo. SmarterASP host: <site>\App_Data, which IIS
# does not serve.
DATA_DIR=

# Required: 40 or more characters. Signs in to every page and API.
OPERATOR_TOKEN=
# Legacy fallback for one release only, when OPERATOR_TOKEN is not set.
VIDEO_ADMIN_TOKEN=

OPENAI_API_KEY=
# OPTIONAL: provider for generation: openai | anthropic | gemini | grok |
# openai-compatible. Use openai-compatible for a local server, for example
# LM Studio at http://localhost:1234/v1 or Ollama.
AI_PROVIDER=openai
# OPTIONAL: base URL of the OpenAI-compatible API (needed for a local server).
AI_BASE_URL=
# OPTIONAL: model used for generation.
AI_MODEL=
# OPTIONAL: API key for the configured provider. On the IIS host, set this and
# the other secrets (OPERATOR_TOKEN, CACHE_KEY_SECRET, GitHub tokens) as
# application pool environment variables, not in a file.
AI_API_KEY=
# Also required for explainer videos (the narrator voice).
OPENROUTER_API_KEY=
# Padding in bytes added to each SSE flush. The SmarterASP IIS host needs 9216,
# because its ARR front end buffers a response below about 8 KB. Leave it unset
# locally.
SSE_FLUSH_PAD_BYTES=

# OPTIONAL: providing one or more GitHub PATs increases GitHub API rate limits.
GITHUB_PAT=
GITHUB_PATS=
# OPTIONAL: GitHub App auth (used when GITHUB_PAT is not provided)
# Either GITHUB_APP_ID or GITHUB_CLIENT_ID can be used as the GitHub App JWT issuer.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# OPTIONAL: explainer videos (feature-flagged; off unless both flags are 1).
VIDEO_EXPLAINER_ENABLED=
NEXT_PUBLIC_VIDEO_EXPLAINER=
# Every video is written by Claude Opus and designed by GPT-6 Sol at medium
# effort, through OPENAI_API_KEY; if Opus fails (out of credit), Sol takes over.
# VIDEO_PREMIUM_OPUS_DESIGNS=1 has Opus design the premium videos too (big
# repositories and the operator's). Videos always
# need OPENAI_API_KEY (Sol and whisper-1) and OPENROUTER_API_KEY (the voice);
# ANTHROPIC_API_KEY only while a configured video model is a Claude model.
ANTHROPIC_API_KEY=
VIDEO_PLANNER_MODEL=
VIDEO_PLANNER_EFFORT=
VIDEO_PREMIUM_OPUS_DESIGNS=
VIDEO_STANDARD_MODEL=
VIDEO_STANDARD_EFFORT=
# Who writes the standard videos' scripts (default claude-opus-5-5); set it to
# the standard model (gpt-6-sol) to have Sol write them as well.
VIDEO_STANDARD_DIRECTOR_MODEL=
# Repositories with at least this many stars always get the premium model (default 10000).
VIDEO_PREMIUM_MIN_STARS=
# Videos are narrated through OpenRouter's text-to-speech (OPENROUTER_API_KEY
# above; Gemini 3.8 Flash TTS, voice Charon), and OPENAI_API_KEY's whisper-1
# times the words. When the OpenRouter balance runs out, new videos pause.
# Videos being made at once across every instance (default 10).
VIDEO_MAX_PAID_RUNS=
# MP4 rendering and posters need a headless Chromium; set to 1 to turn them on.
VIDEO_RENDER_ENABLED=
# The headless Chromium (or Chrome) executable the renders launch.
VIDEO_RENDER_CHROME_PATH=
# Extra Chromium flags, space-separated (for example --no-sandbox when the
# renderer runs as root).
VIDEO_RENDER_CHROME_ARGS=
# Chromium renders one instance runs at once in production (default 1).
VIDEO_SEGMENT_CONCURRENCY=
# Segment requests one MP4 render keeps in flight (default 10).
VIDEO_SEGMENT_FAN_OUT=
# The origin the server calls itself on for renders. Default:
# http://127.0.0.1:$PORT in a production server, else the request's origin.
VIDEO_INTERNAL_ORIGIN=
# Development only: set to limit to preview the paused video UI.
VIDEO_PREVIEW_PAUSED=
